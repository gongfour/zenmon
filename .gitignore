/target
# Default OUT_DIR of scripts/release/package-cli.sh — release archives, their
# manifest fragments, and the assembled zenmon.json.
/dist
# Cargo.lock IS committed. This repository ships binaries: a tagged release must
# rebuild months later from the same dependency versions, and `--locked` in CI
# and the release workflow can only enforce that if the lockfile is tracked.
.worktrees/
# CI staging area for the CLI binary the release installer bundles as an
# externalBin (see tauri.release.conf.json); never committed.
/tray/src-tauri/binaries/
.superpowers/

# Internal design/plan docs and project contracts (may reference proprietary systems)
/docs/superpowers/
/contracts/
